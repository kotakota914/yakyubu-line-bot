# LINE Developersコンソール > Messaging API設定 で取得できる値
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# 管理者登録に使う合言葉。監督・マネージャーなど特定の人だけに伝える。
# LINEで「管理者登録 ここに設定した合言葉」と送ると管理者として登録される。
ADMIN_SECRET=change_this_to_your_own_secret

# サーバーのポート番号(Renderなどにデプロイする場合は自動で設定されるため通常は変更不要)
PORT=3000

# 毎朝7:00に当日の試合・練習予定を友だち全員へ自動送信するか(true/false)
# ブロードキャストは月間無料メッセージ数を消費するため、部員数と相談してから有効化してください。
ENABLE_DAILY_REMINDER=false
